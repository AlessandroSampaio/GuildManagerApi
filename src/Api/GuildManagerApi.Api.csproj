<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <RootNamespace>GuildManagerApi.Api</RootNamespace>
        <AssemblyName>GuildManagerApi.Api</AssemblyName>

        <!-- Generate XML docs for Swagger XML comments -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Domain\GuildManagerApi.Domain.csproj" />
      <ProjectReference
            Include="..\Application\GuildManagerApi.Application.csproj"
        />
      <ProjectReference
            Include="..\Infrastructure\GuildManagerApi.Infrastructure.csproj"
        />
    </ItemGroup>

    <ItemGroup>
      <!-- EF Core CLI tools for running migrations from the API project -->
      <PackageReference
            Include="Microsoft.EntityFrameworkCore.Design"
            Version="10.0.3"
        >
        <IncludeAssets
            >runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>

      <!-- Swagger / OpenAPI -->
      <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.4" />
    </ItemGroup>
</Project>
