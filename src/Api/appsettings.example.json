      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 120
      },
      {
        "Endpoint": "*",
        "Period": "1h",
        "Limit": 3000
      },
      {
        "Endpoint": "POST:/api/*",
        "Period": "1m",
        "Limit": 30
      }
    ]
  },
  "RaiderIoSync": {
    "SyncIntervalHours": 6,
    "ThrottleDelayMs": 300
  },
  "Logging": {
    "LogLevel": {
